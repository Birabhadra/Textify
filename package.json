{
  "name": "textify",
  "displayName": "Textify",
  "description": "A VS Code AI Autocomplete Engine that provides real-time, repository-aware code completions as developers type.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished" 
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration":{
      "title": "Textify",
      "properties": {
        "textify.fireworksApiKey":{
          "type":"string",
          "default":"",
          "description": "Fireworks Api Key "
        },
        "textify.openrouterApiKey":{
          "type":"string",
          "default":"",
          "description": "Openrouter Api Key "
        },
        "textify.groqApiKey":{
          "type":"string",
          "default":"",
          "description": "Groq Api Key"
        },
        "textify.model":{
          "type":"string",
          "default":"qwen/qwen3-32b",
          "description": "AI models to use for completions"
        },
        "textify.maxTokens":{
          "type":"number",
          "default":500,
          "description": "Maximum tokens to generate"
        }
      }
    },
    "commands": [
      {
        "command": "textify.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
